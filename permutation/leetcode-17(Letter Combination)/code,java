class Solution {
    List<String> ans=new ArrayList<>();
    public List<String> letterCombinations(String digits){
        
        helper(digits,"");
        return ans;
    }
    void helper(String up,String p){
        if(up.isEmpty()){
            ans.add(p);
            return;
        }
        int digit=up.charAt(0)-'0';
        int ini,con;
        if(digit>=2&&digit<7){
            ini=((digit-1)*3)-3;
            con=(digit-1)*3;

        }   
        else if(digit==7){
            ini=((digit-1)*3)-3;;
            con=((digit-1)*3)+1;
             

        }
        else if(digit==8){
            con=((digit-1)*3)+1;
            ini=((digit-1)*3)-2;
        }
        else{
            ini=((digit-1)*3)-2;
            con=((digit-1)*3)+2;
        }
        for(int i=ini;i<con;i++){
            char ch=(char) ('a'+i);
            helper(up.substring(1),p+ch);
        }
    }

}
